.combo-header-wrap.active .combo-popover-menu {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transform: translateY(0) scale(1);
}
.combo-popover-inner {
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.combo-menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 9px 12px;
  border-radius: 10px;
  gap: 10px;
}
.combo-menu-item.active {
  background: rgba(0, 113, 227, 0.06);
}
.combo-item-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.combo-item-top {
  display: flex;
  align-items: center;
  gap: 6px;
}
.combo-item-name {
  font-size: 13.5px;
  font-weight: 600;
  color: #1d1d1f;
  letter-spacing: -0.01em;
}
.combo-menu-item.active .combo-item-name {
  color: #0071e3;
}
.combo-item-key {
  font-size: 10.5px;
  font-weight: 700;
  padding: 1.5px 6px;
  border-radius: 5px;
  background: #f2f2f7;
  color: #48484a;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}
.combo-menu-item.active .combo-item-key {
  background: rgba(0, 113, 227, 0.12);
  color: #0071e3;
}
.combo-item-desc {
  font-size: 11px;
  color: #8e8e93;
  line-height: 1.2;
}
.combo-check-icon {
  width: 15px;
  height: 15px;
  display: block;
  flex-shrink: 0;
}

/* 伤害对决子项 */
.compare-metric-row {
  padding: 16px 0;
  border-bottom: 0.5px solid rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.compare-metric-row:last-child {
  border-bottom: none;
  padding-bottom: 8px;
}
.metric-card-head {
  font-size: 14px;
  font-weight: 700;
  color: #000000;
  letter-spacing: -0.01em;
}
.metric-card-sub {
  font-size: 11px;
  color: #8e8e93;
  margin-top: 3px;
  margin-bottom: 12px;
}
.metric-cols-row {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 0 8px;
}
.metric-side-col {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.metric-num-val {
  font-size: 28px;
  font-weight: 700;
  color: #000000;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
}
.metric-num-unit {
  font-size: 12px;
  font-weight: 500;
  color: #8e8e93;
  margin-left: 2px;
}
.metric-vs-sep {
  font-size: 11px;
  font-weight: 600;
  color: #8e8e93;
  padding: 0 12px;
  text-transform: lowercase;
}
.metric-winner-wrap {
  margin-top: 8px;
}
.apple-winner-pill {
  font-size: 11.5px;
  font-weight: 600;
  padding: 3.5px 12px;
  border-radius: 9999px;
  display: inline-flex;
  align-items: center;
  background: #ffffff;
  border: 0.5px solid rgba(0, 0, 0, 0.08);
}
.winner-a {
  background: #ffffff;
  color: #007aff;
  border: 0.5px solid rgba(0, 122, 255, 0.45);
  box-shadow: 0 1px 3px rgba(0, 122, 255, 0.06);
}
.winner-b {
  background: #ffffff;
  color: #1f7a34;
  border: 0.5px solid rgba(52, 199, 89, 0.45);
  box-shadow: 0 1px 3px rgba(52, 199, 89, 0.08);
}
.winner-tie {
  background: #ffffff;
  color: #8e8e93;
  border: 0.5px solid #e5e5ea;
  box-shadow: none;
}

/* 二级数据视窗入口 */
.action-entry-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1px solid #f2f2f7;
  padding: 12px 2px 2px;
  font-size: 11.5px;
  margin-top: 8px;
}
.action-entry-row:active {
  opacity: 0.7;
}
.action-entry-left {
  display: flex;
  align-items: center;
  gap: 9px;
}
.action-entry-icon-chip {
  width: 24px;
  height: 24px;
  border-radius: 6px;
  background: #f2f2f7;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.entry-bolt-svg {
  width: 13px;
  height: 13px;
  display: block;
}
.action-entry-text-col {
  display: flex;
  align-items: center;
  gap: 7px;
}
.action-entry-label {
  font-size: 11px;
  font-weight: 600;
  color: #8e8e93;
  letter-spacing: -0.01em;
  white-space: nowrap;
}
.action-entry-desc {
  font-size: 12px;
  font-weight: 500;
  color: #48484a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.action-entry-link {
  color: #8e8e93;
  font-size: 11.5px;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 2px;
  white-space: nowrap;
}

/* 机制差异与核心被动对比 */
.mechanic-diff-deck {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.mechanic-section-group {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.mechanic-group-header {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 0 0 4px 0;
}
.mechanic-group-tag {
  font-size: 11px;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: 4px;
  letter-spacing: -0.01em;
}
.mechanic-group-tag.tag-a {
  background: rgba(0, 122, 255, 0.1);
  color: #007aff;
}
.mechanic-group-tag.tag-b {
  background: rgba(52, 199, 89, 0.12);
  color: #248a3d;
}
