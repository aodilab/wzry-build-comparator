.shop-card-price-pill::before {
  content: '🪙';
  font-size: 10px;
  line-height: 1;
  opacity: 0.85;
}

/* 下半区：舒适从容检视看板 */
.shop-inspector-section-label {
  display: none;
}
.shop-inspector-panel {
  flex-shrink: 0;
  height: 226px;
  min-height: 226px;
  max-height: 226px;
  background: #ffffff;
  border-radius: 18px;
  padding: 10px 14px 12px;
  border: 1px solid #ebebf0;
  display: flex;
  flex-direction: column;
  gap: 7px;
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.04);
  margin-top: 6px;
}
.inspector-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10px;
}
.inspector-icon {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  flex-shrink: 0;
  background: #f2f2f7;
  border: 0.5px solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
}
.inspector-info-col {
  display: flex;
  flex-direction: column;
  gap: 3px;
  flex: 1;
  min-width: 0;
}
.inspector-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}
.inspector-name {
  font-size: 15px;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: -0.02em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.inspector-price-capsule {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  height: 22px;
  padding: 0 8px;
  border-radius: 999px;
  background: #ffffff;
  border: 0.5px solid #e5e5ea;
  font-size: 11.5px;
  font-weight: 600;
  color: #1d1d1f;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}
.inspector-cat-badge {
  font-size: 10.5px;
  font-weight: 500;
  padding: 1.5px 6px;
  border-radius: 4px;
  background: #f2f2f7;
  color: #636366;
}
.inspector-stats-row {
  flex-shrink: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 4px 5px;
  align-items: center;
  margin-top: 1px;
}
.inspector-stat-chip {
  font-size: 10.5px;
  font-weight: 500;
  padding: 1.5px 6px;
  border-radius: 5px;
  white-space: nowrap;
  background: #f5f5f7;
  color: #1d1d1f;
  border: 0.5px solid rgba(0, 0, 0, 0.04);
}
.inspector-mechanics-wrap {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  background: #f8f9fa;
  border-radius: 11px;
  padding: 7px 11px;
  display: flex;
  flex-direction: column;
  gap: 0;
}
.inspector-mech-row {
  display: flex;
  flex-direction: column;
  gap: 2.5px;
  padding: 2px 0;
}
.inspector-mech-row + .inspector-mech-row {
  border-top: 0.5px solid rgba(0, 0, 0, 0.06);
  margin-top: 5px;
  padding-top: 5px;
}
.inspector-mech-title-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
}
.inspector-mech-badge {
  display: inline-flex;
  align-items: center;
  font-size: 10.5px;
  font-weight: 600;
  padding: 1.5px 6.5px;
  border-radius: 4px;
  line-height: 1.25;
  background: #f0f1f4;
  color: #1d1d1f;
  border: 0.5px solid rgba(0, 0, 0, 0.04);
}
.inspector-mech-badge.badge-active {
  background: #e5e5ea;
  color: #000000;
  font-weight: 700;
}
.inspector-mech-badge.badge-passive {
  background: #f0f1f4;
  color: #3a3a3c;
}
.inspector-mech-badge.badge-rule {
  background: #f0f1f4;
  color: #636366;
}
.inspector-mech-cd {
  font-size: 10px;
  font-weight: 500;
  color: #8e8e93;
  background: #ffffff;
  padding: 1px 6px;
  border-radius: 4px;
  border: 0.5px solid #e5e5ea;
  font-variant-numeric: tabular-nums;
}
.inspector-mech-desc {
  font-size: 11px;
  color: #3a3a3c;
  line-height: 1.44;
}
.inspector-empty-hint {
  display: flex;
  flex-direction: column;
  gap: 2.5px;
  padding: 2px 0;
}
.empty-hint-tag {
  font-size: 10.5px;
  font-weight: 700;
  color: #007aff;
}
.empty-hint-desc {
  font-size: 11px;
  color: #636366;
  line-height: 1.46;
}
.inspector-equip-btn {
  width: 100%;
  height: 36px;
  border-radius: 999px;
  background: #007aff;
  color: #ffffff;
  font-size: 13px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(0, 122, 255, 0.2);
  flex-shrink: 0;
}
/* 专属装备属性与机制检视卡 (Item Inspector Sheet) */
.item-inspector-sheet {
  background: #ffffff;
  padding: 6px 18px 24px;
  box-shadow: 0 -16px 48px rgba(0, 0, 0, 0.14);
  max-height: 85vh;
  height: auto;
  display: flex;
  flex-direction: column;
}
.item-inspector-content {
  display: flex;
  flex-direction: column;
  gap: 16px;
  margin-top: 10px;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  max-height: calc(85vh - 150px);
  padding-right: 2px;
}
.item-inspector-content .inspector-header {
  background: transparent;
  padding: 0 0 14px 0;
  border-bottom: 0.5px solid rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  gap: 14px;
}
.item-inspector-content .inspector-icon {
  width: 58px;
  height: 58px;
  border-radius: 14px;
  flex-shrink: 0;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  border: 1px solid rgba(0, 0, 0, 0.04);
  background: #f5f5f7;
}
.item-inspector-content .inspector-info-col {
  display: flex;
  flex-direction: column;
  gap: 3px;
  flex: 1;
  min-width: 0;
}
.item-inspector-content .inspector-name {
  font-size: 19px;
  font-weight: 700;
  color: #1d1d1f;
  letter-spacing: -0.02em;
  line-height: 1.2;
}
