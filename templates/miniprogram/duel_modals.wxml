  <wxs src="./sheet_gesture.wxs" module="sheetGesture" />
  <!-- 专属装备属性与机制检视卡 (Apple Sheet) -->
  <view class="modal-mask modal-mask-inspector {{showItemInspector ? 'active' : ''}}" show="{{showItemInspector}}" change:show="{{sheetGesture.onInspectorShowChange}}" style="{{sheetMaskStyle.inspector || ''}}" bindtap="closeItemInspector" catchtouchmove="noop">
    <view class="sheet-box item-inspector-sheet sheet-box-inspector" style="{{sheetBoxStyle.inspector || ''}}" catchtap="noop">
      <view class="sheet-grabber" data-sheet="inspector" data-zone="header" bindtouchstart="{{sheetGesture.onTouchStart}}" catchtouchmove="{{sheetGesture.onTouchMove}}" bindtouchend="{{sheetGesture.onTouchEnd}}" bindtouchcancel="{{sheetGesture.onTouchEnd}}"></view>
      <view class="sheet-title-bar" data-sheet="inspector" data-zone="header" bindtouchstart="{{sheetGesture.onTouchStart}}" catchtouchmove="{{sheetGesture.onTouchMove}}" bindtouchend="{{sheetGesture.onTouchEnd}}" bindtouchcancel="{{sheetGesture.onTouchEnd}}">
        <text class="sheet-title-txt">装备机制与属性</text>
        <view class="sheet-close-btn" data-role="close" catchtap="closeItemInspector" catchtouchend="closeItemInspector">
          <image class="sheet-close-svg" data-role="close" src="/assets/ic_close_sheet.png" mode="aspectFit" />
        </view>
      </view>

      <view class="item-inspector-content" wx:if="{{inspectorItem}}" data-sheet="inspector" data-zone="body" bindtouchstart="{{sheetGesture.onTouchStart}}" bindtouchmove="{{sheetGesture.onTouchMove}}" bindtouchend="{{sheetGesture.onTouchEnd}}" bindtouchcancel="{{sheetGesture.onTouchEnd}}">
        <view class="inspector-header">
          <image class="inspector-icon" src="{{inspectorItem.icon}}" mode="aspectFill" />
          <view class="inspector-info-col">
            <view class="inspector-name">{{inspectorItem.item_name}}</view>
            <view class="inspector-subtitle">{{inspectorItem.category}}装备 · 顶级神装</view>
            <view class="inspector-meta-line">
              <text class="price-gold-txt">{{inspectorItem.priceFormatted}} 金币</text>
            </view>
          </view>
        </view>

        <view class="item-inspector-section">
          <view class="item-inspector-section-label">基础属性</view>
          <view class="inspector-stats-grid">
            <view wx:for="{{inspectorItem.statCells}}" wx:key="index" class="inspector-stat-cell" style="{{item.isGray ? 'color:#8e8e93;' : ''}}">
              <text class="inspector-stat-val">{{item.val}}</text>
              <text wx:if="{{item.name}}" class="inspector-stat-name">{{item.name}}</text>
            </view>
          </view>
        </view>

        <view class="item-inspector-section">
          <view class="item-inspector-section-label">唯一被动与专属机制</view>
          <view class="inspector-mechanics-wrap">
            <view wx:if="{{!inspectorItem.hasPassives}}" style="font-size:12.5px; color:#8e8e93; padding:8px 0;">
              该装备为纯数值加成，无附带被动机制，适合作为核心大件的前置过渡。
            </view>
            <block wx:else>
              <view wx:for="{{inspectorItem.regularPassives}}" wx:key="index" class="inspector-mech-row">
                <view class="inspector-mech-title-bar">
                  <text class="inspector-mech-title-text"><text class="inspector-mech-badge-icon">◈</text> {{item.titleTxt}}</text>
                  <text wx:if="{{item.cd}}" class="inspector-mech-cd">{{item.cd}}</text>
                </view>
                <rich-text class="inspector-mech-desc" nodes="{{item.richDesc}}"></rich-text>
              </view>
              <view wx:if="{{inspectorItem.ruleItemsText}}" class="inspector-mech-row" style="background:#f2f2f7;">
                <view class="inspector-mech-title-bar">
                  <text class="inspector-mech-title-text" style="color:#636366;"><text class="inspector-mech-badge-icon" style="color:#8e8e93;">ℹ</text> 通用规则机制</text>
                </view>
                <view class="inspector-mech-desc" style="color:#636366;">{{inspectorItem.ruleItemsText}}</view>
              </view>
            </block>
          </view>
        </view>
      </view>

      <view class="item-inspector-actions">
        <view class="btn-inspector-replace" catchtap="openShopFromInspector">
          <image class="inspector-action-ic-replace" src="/assets/ic_replace_white.png" mode="aspectFit" />
          <text>去商店替换</text>
        </view>
        <view class="btn-inspector-unequip" catchtap="unequipFromInspector">
          <image class="inspector-action-ic-trash" src="/assets/ic_trash_red.png" mode="aspectFit" />
          <text>卸下此槽</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 装备商店抽屉 (Apple Sheet) -->
  <view class="modal-mask modal-mask-shop {{showShopSheet ? 'active' : ''}}" show="{{showShopSheet}}" change:show="{{sheetGesture.onShopShowChange}}" style="{{sheetMaskStyle.shop || ''}}" bindtap="closeShopSheet" catchtouchmove="noop">
    <view class="sheet-box shop-sheet sheet-box-shop" style="{{sheetBoxStyle.shop || ''}}" catchtap="noop">
      <view class="sheet-grabber" data-sheet="shop" data-zone="header" bindtouchstart="{{sheetGesture.onTouchStart}}" catchtouchmove="{{sheetGesture.onTouchMove}}" bindtouchend="{{sheetGesture.onTouchEnd}}" bindtouchcancel="{{sheetGesture.onTouchEnd}}"></view>
      <view class="sheet-title-bar" data-sheet="shop" data-zone="header" bindtouchstart="{{sheetGesture.onTouchStart}}" catchtouchmove="{{sheetGesture.onTouchMove}}" bindtouchend="{{sheetGesture.onTouchEnd}}" bindtouchcancel="{{sheetGesture.onTouchEnd}}">
        <view wx:if="{{canUnequipCurrentSlot}}" class="sheet-top-unequip-btn" data-role="close" catchtap="unequipCurrentSlot" catchtouchend="unequipCurrentSlot">卸下</view>
        <text class="sheet-title-txt">装配神装</text>
        <view class="sheet-close-btn" data-role="close" catchtap="closeShopSheet" catchtouchend="closeShopSheet">
          <image class="sheet-close-svg" data-role="close" src="/assets/ic_close_shop.png" mode="aspectFit" />
        </view>
      </view>

      <view class="shop-header-pinned">
        <view class="shop-search-bar">
          <image class="shop-search-icon" src="/assets/ic_search_blue.png" mode="aspectFit" />
          <input wx:if="{{showShopSheet}}" type="text" class="shop-search-input" value="{{shopKw}}" placeholder="搜索装备名称或属性 (如: 穿透、暴击、吸血)" placeholder-class="shop-search-ph" bindinput="onShopSearch" />
        </view>
        <view class="apple-seg-control" style="margin-top:2px; margin-bottom:0;">
          <view wx:for="{{shopCats}}" wx:key="*this" class="apple-seg-item {{shopCat === item ? 'active' : ''}}" data-cat="{{item}}" catchtap="setShopCat">{{item}}</view>
        </view>
      </view>

      <!-- 上半区：双列极简选装网格 (可滚动) -->
      <scroll-view scroll-y="true" bounces="{{false}}" show-scrollbar="{{false}}" upper-threshold="10" class="shop-grid-scroll-area" data-sheet="shop" data-zone="body" bindscroll="{{sheetGesture.onScroll}}" bindscrolltoupper="{{sheetGesture.onScrollToUpper}}" bindtouchstart="{{sheetGesture.onTouchStart}}" bindtouchmove="{{sheetGesture.onTouchMove}}" bindtouchend="{{sheetGesture.onTouchEnd}}" bindtouchcancel="{{sheetGesture.onTouchEnd}}">
        <view wx:if="{{filteredShopItems.length === 0}}" style="text-align:center; padding:40px 0; color:var(--apple-text-secondary); font-size:13px;">
          未检索到符合条件的装备
        </view>
        <view wx:else class="shop-grid-2col">
          <view wx:for="{{filteredShopItems}}" wx:key="item_name" class="shop-grid-card {{previewingItemName === item.item_name ? 'active' : ''}}" data-name="{{item.item_name}}" catchtap="previewShopItem">
            <image class="shop-card-icon" src="{{item.icon}}" mode="aspectFill" lazy-load />
            <view class="shop-card-meta">
              <text class="shop-card-name">{{item.item_name}}</text>
              <text class="shop-card-price-pill">{{item.total_price || 0}}</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <!-- 下半区：详情检查与装配面板 (严格对齐图4 Inset Grouped) -->
      <view class="shop-inspector-section-label">装备机制与规格</view>
      <view class="shop-inspector-panel">
        <view wx:if="{{!shopInspector}}" style="text-align:center; color:var(--apple-text-secondary); padding:20px; font-size:12px;">请点选上方装备查看加成与被动</view>
        <block wx:else>
          <view class="inspector-header">
            <image class="inspector-icon" src="{{shopInspector.icon}}" mode="aspectFill" />
            <view class="inspector-info-col">
              <view class="inspector-name-row">
                <view style="display:flex; align-items:center; gap:6px;">
                  <text class="inspector-name">{{shopInspector.item_name}}</text>
                  <text class="inspector-cat-badge">{{shopInspector.category}}</text>
                </view>
                <text class="inspector-price-capsule">🪙 {{shopInspector.total_price}}</text>
              </view>
              <view class="inspector-stats-row">
                <text wx:for="{{shopInspector.statChips}}" wx:key="*this" class="inspector-stat-chip">{{item}}</text>
              </view>
            </view>
          </view>

          <view class="inspector-mechanics-wrap">
            <view wx:if="{{!shopInspector.hasPassives}}" class="inspector-empty-hint">
              <view class="empty-hint-tag">基础配件 · 核心增益</view>
              <view class="empty-hint-desc">本装备为基础核心构件，提供纯正属性加成，可向上合成高阶神装。</view>
            </view>
            <block wx:else>
              <view wx:for="{{shopInspector.regularPassives}}" wx:key="index" class="inspector-mech-row">
                <view class="inspector-mech-title-bar">
                  <text class="inspector-mech-badge {{item.badgeClass}}">{{item.title}}</text>
                  <text wx:if="{{item.cd}}" class="inspector-mech-cd">{{item.cd}}</text>
                </view>
                <view class="inspector-mech-desc">{{item.cleanDesc}}</view>
              </view>
              <view wx:if="{{shopInspector.ruleItemsText}}" class="inspector-mech-row">
                <view class="inspector-mech-title-bar">
                  <text class="inspector-mech-badge badge-rule">通用规则机制</text>
                </view>
                <view class="inspector-mech-desc" style="color:#636366;">{{shopInspector.ruleItemsText}}</view>
              </view>
            </block>
          </view>

          <view class="inspector-equip-btn" data-name="{{shopInspector.item_name}}" catchtap="confirmEquipItem">
            装配到当前格 ({{targetSlotLabel}})
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 铭文配置抽屉 (Apple Sheet) -->
  <view class="modal-mask modal-mask-arcana {{showArcanaSheet ? 'active' : ''}}" show="{{showArcanaSheet}}" change:show="{{sheetGesture.onArcanaShowChange}}" style="{{sheetMaskStyle.arcana || ''}}" bindtap="closeArcanaSheet" catchtouchmove="noop">
    <view class="sheet-box sheet-box-arcana" style="{{sheetBoxStyle.arcana || ''}}" catchtap="noop">
      <view class="sheet-grabber" data-sheet="arcana" data-zone="header" bindtouchstart="{{sheetGesture.onTouchStart}}" catchtouchmove="{{sheetGesture.onTouchMove}}" bindtouchend="{{sheetGesture.onTouchEnd}}" bindtouchcancel="{{sheetGesture.onTouchEnd}}"></view>
      <view class="sheet-title-bar" data-sheet="arcana" data-zone="header" bindtouchstart="{{sheetGesture.onTouchStart}}" catchtouchmove="{{sheetGesture.onTouchMove}}" bindtouchend="{{sheetGesture.onTouchEnd}}" bindtouchcancel="{{sheetGesture.onTouchEnd}}">
        <view class="sheet-title-col">
          <text class="sheet-title-txt">配置五级铭文</text>
          <text class="sheet-subtitle-txt">每种颜色上限装配 10 颗 · 点击加减自由微调</text>
        </view>
        <view class="sheet-close-btn" data-role="close" catchtap="closeArcanaSheet" catchtouchend="closeArcanaSheet">
          <image class="sheet-close-svg" data-role="close" src="/assets/ic_close_sheet.png" mode="aspectFit" />
        </view>
      </view>

      <view class="apple-seg-control" style="margin-top:8px; margin-bottom:8px;">
        <view class="apple-seg-item {{arcColor === 'red' ? 'active' : ''}}" data-color="red" catchtap="setArcanaColor">红色</view>
        <view class="apple-seg-item {{arcColor === 'blue' ? 'active' : ''}}" data-color="blue" catchtap="setArcanaColor">蓝色</view>
        <view class="apple-seg-item {{arcColor === 'green' ? 'active' : ''}}" data-color="green" catchtap="setArcanaColor">绿色</view>
      </view>

      <scroll-view scroll-y="true" bounces="{{false}}" show-scrollbar="{{false}}" upper-threshold="10" class="sheet-scroll-body" data-sheet="arcana" data-zone="body" bindscroll="{{sheetGesture.onScroll}}" bindscrolltoupper="{{sheetGesture.onScrollToUpper}}" bindtouchstart="{{sheetGesture.onTouchStart}}" bindtouchmove="{{sheetGesture.onTouchMove}}" bindtouchend="{{sheetGesture.onTouchEnd}}" bindtouchcancel="{{sheetGesture.onTouchEnd}}">
        <view style="font-size:12px; color:var(--apple-text-secondary); margin-bottom:12px; display:flex; justify-content:space-between; align-items:center;">
          <view>当前色系装配: <text style="color:var(--apple-text-primary); font-weight:600;">{{arcColorTotalCount}}/10</text> 颗</view>
          <text style="color:#ff3b30; font-weight:500;" catchtap="clearCurrentArcanaColor">清空此色</text>
        </view>
        <view class="arcana-grid-list">
          <view wx:for="{{filteredArcanaList}}" wx:key="name" class="arcana-item-row">
            <view class="arc-row-left">
              <image wx:if="{{item.icon}}" class="arc-row-icon" src="{{item.icon}}" mode="aspectFill" />
              <view class="arc-row-text">
                <text class="arc-row-name">{{item.name}}</text>
                <text class="arc-row-props">{{item.propsText}}</text>
              </view>
            </view>
            <view class="arc-row-counter">
              <view class="arc-cnt-btn" data-name="{{item.name}}" data-delta="-1" catchtap="changeArcanaCount">-</view>
              <text class="arc-cnt-val">{{item.count}}</text>
              <view class="arc-cnt-btn" data-name="{{item.name}}" data-delta="1" catchtap="changeArcanaCount">+</view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 各技能详细物理拆解与效果对决二级视窗 (Apple iOS Sheet 规格) -->
  <view class="modal-mask modal-mask-skill skill-detail-modal {{showSkillDetailModal ? 'active' : ''}}" show="{{showSkillDetailModal}}" change:show="{{sheetGesture.onSkillShowChange}}" style="{{sheetMaskStyle.skill || ''}}" bindtap="closeSkillDetailModal" catchtouchmove="noop">
    <view class="sheet-box skill-detail-sheet sheet-box-skill" style="{{sheetBoxStyle.skill || ''}}" catchtap="noop">
      <view class="sheet-grabber" data-sheet="skill" data-zone="header" bindtouchstart="{{sheetGesture.onTouchStart}}" catchtouchmove="{{sheetGesture.onTouchMove}}" bindtouchend="{{sheetGesture.onTouchEnd}}" bindtouchcancel="{{sheetGesture.onTouchEnd}}"></view>
      <view class="detail-modal-header" data-sheet="skill" data-zone="header" bindtouchstart="{{sheetGesture.onTouchStart}}" catchtouchmove="{{sheetGesture.onTouchMove}}" bindtouchend="{{sheetGesture.onTouchEnd}}" bindtouchcancel="{{sheetGesture.onTouchEnd}}">
        <view class="detail-modal-nav-row">
          <view class="detail-modal-hero-chip">
            <image class="detail-modal-hero-avatar" src="{{heroAvatar}}" mode="aspectFill" />
            <view class="detail-modal-hero-info">
              <view class="detail-modal-hero-name-row">
                <text class="detail-modal-hero-name">{{hero.cname}}</text>
                <text class="detail-modal-hero-role">{{hero.role || '英雄'}} · {{currentLane || '实战'}}</text>
              </view>
            </view>
          </view>
          <view class="sheet-close-btn" data-role="close" catchtap="closeSkillDetailModal" catchtouchend="closeSkillDetailModal">
            <image class="sheet-close-svg" data-role="close" src="/assets/ic_close_sheet.png" mode="aspectFit" />
          </view>
        </view>

        <view class="detail-intro-bar">
          <view class="detail-intro-title">技能伤害与效果对决</view>
          <view class="modal-benchmark-hint">{{skillDetailData.benchmarkHint}}</view>
        </view>
      </view>

      <scroll-view scroll-y="true" bounces="{{false}}" show-scrollbar="{{false}}" upper-threshold="10" class="detail-modal-content" data-sheet="skill" data-zone="body" bindscroll="{{sheetGesture.onScroll}}" bindscrolltoupper="{{sheetGesture.onScrollToUpper}}" bindtouchstart="{{sheetGesture.onTouchStart}}" bindtouchmove="{{sheetGesture.onTouchMove}}" bindtouchend="{{sheetGesture.onTouchEnd}}" bindtouchcancel="{{sheetGesture.onTouchEnd}}">
        <view class="skill-cards-deck">
          <view wx:for="{{skillDetailData.cards}}" wx:for-item="card" wx:key="index" class="skill-detail-card">
            <view class="skill-card-top">
              <view class="skill-card-ident">
                <image wx:if="{{card.isAttack}}" class="skill-badge-img skill-badge-attack-real" src="{{card.icon}}" mode="aspectFill" />
                <image wx:else class="skill-badge-img" src="{{card.icon}}" mode="aspectFill" />
                <view class="skill-ident-title">{{card.title}}</view>
              </view>
              <text class="{{card.isAttack ? 'skill-spec-tag' : 'skill-cd-badge'}}">{{card.badge}}</text>
            </view>

            <view class="skill-metrics-table">
              <view class="skill-metric-row header-row">
                <view class="m-head-title">指标</view>
                <view class="m-head-side left"><text class="build-badge badge-left">方案 A</text></view>
                <view class="m-head-side right"><text class="build-badge badge-right">方案 B</text></view>
              </view>

              <block wx:for="{{card.rows}}" wx:for-item="row" wx:key="index">
                <view wx:if="{{row.isDual}}" class="skill-metric-row dual-dmg-row">
                  <view class="m-name-col">
                    <view class="m-metric-title">{{row.title}}</view>
                    <view class="m-metric-sub">{{row.sub}}</view>
                  </view>
                  <view class="m-val-col left">
                    <view class="val-primary {{row.resSq.aWins ? 'win-a' : ''}}">
                      <text>{{row.sqA}}</text>
                      <text wx:if="{{row.resSq.badgeA}}" class="win-diff-pill win-a">{{row.resSq.badgeA}}</text>
                    </view>
                    <view class="val-secondary">
                      <text>{{row.tkA}}</text>
                    </view>
                  </view>
                  <view class="m-val-col right">
                    <view class="val-primary {{row.resSq.bWins ? 'win-b' : ''}}">
                      <text>{{row.sqB}}</text>
                      <text wx:if="{{row.resSq.badgeB}}" class="win-diff-pill win-b">{{row.resSq.badgeB}}</text>
                    </view>
                    <view class="val-secondary">
                      <text>{{row.tkB}}</text>
                    </view>
                  </view>
                </view>

                <view wx:else class="skill-metric-row single-row">
                  <view class="m-name-col">
                    <view class="m-metric-title">{{row.mainTitle}}</view>
                    <view wx:if="{{row.subTitle}}" class="m-metric-sub">{{row.subTitle}}</view>
                  </view>
                  <view class="m-val-col left">
                    <view class="val-single {{row.res.aWins ? 'win-a' : ''}}">
                      <text>{{row.valA}}</text>
                      <text wx:if="{{row.res.badgeA}}" class="win-diff-pill win-a">{{row.res.badgeA}}</text>
                    </view>
                  </view>
                  <view class="m-val-col right">
                    <view class="val-single {{row.res.bWins ? 'win-b' : ''}}">
                      <text>{{row.valB}}</text>
                      <text wx:if="{{row.res.badgeB}}" class="win-diff-pill win-b">{{row.res.badgeB}}</text>
                    </view>
                  </view>
                </view>
              </block>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
