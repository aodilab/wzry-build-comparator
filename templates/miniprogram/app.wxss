/* 全局样式 - 苹果经典银白浅色风格 (Apple HIG Silver-White) */
page {
  background-color: #f5f5f7;
  color: #1d1d1f;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, button, scroll-view, image {
  box-sizing: border-box;
}

/* Apple 全局设计变量与调色板 */
page {
  --color-blue: #0071e3;
  --color-blue-bg: rgba(0, 113, 227, 0.08);
  --color-green: #34c759;
  --color-green-bg: rgba(52, 199, 89, 0.1);
  --color-amber: #d97706;
  --color-amber-bg: rgba(217, 119, 6, 0.08);
  --color-red: #ff3b30;
  --color-red-bg: rgba(255, 59, 48, 0.08);
  --color-purple: #af52de;
  --color-purple-bg: rgba(175, 82, 222, 0.08);
  --apple-card: #ffffff;
  --apple-subcard: #f8f8fa;
  --apple-border: rgba(0, 0, 0, 0.06);
  --card-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
  --text-primary: #1d1d1f;
  --text-secondary: #6e6e73;
  --text-tertiary: #86868b;
}

/* 全局模态框遮罩 (Apple Modal Backdrop) */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}
