<!-- 王者出装推演 ｜ 页面一：挑选英雄大厅 (1:1 复刻 preview_miniprogram.html) -->
<view class="hall-page">
  <view class="hall-wrap">
    <view class="hall-main-title">挑选演练英雄</view>
    <view class="hall-sub-title">点击英雄即刻进入专属配装与实战对决</view>

    <view class="apple-search-box">
      <image class="search-svg-icon" src="/assets/ic_search_gray.png" mode="aspectFit" />
      <input class="apple-search-input" type="text" placeholder="搜索英雄（如：孙尚香 / 李白）" placeholder-class="search-ph" value="{{hallKw}}" bindinput="onHallSearch" />
    </view>

    <view class="apple-seg-control">
      <block wx:for="{{roles}}" wx:key="*this">
        <view class="apple-seg-item {{item === hallRole ? 'active' : ''}}" bindtap="setHallRole" data-role="{{item}}">
          {{item}}
        </view>
      </block>
    </view>

    <view class="hall-hero-grid">
      <block wx:for="{{filteredHeroes}}" wx:key="ename">
        <view class="hall-hero-tile" bindtap="onHeroCardClick" data-cname="{{item.cname}}">
          <image class="hall-hero-avatar" src="https://game.gtimg.cn/images/yxzj/img201606/heroimg/{{item.ename}}/{{item.ename}}.jpg" mode="aspectFill" lazy-load />
          <view class="hall-hero-name">{{item.cname}}</view>
        </view>
      </block>
    </view>
  </view>

  <!-- 英雄分路选择弹窗 (1:1 复刻 #laneSelectModal) -->
  <view class="lane-modal-mask {{showLaneModal ? 'active' : ''}}" bindtap="closeLaneModal">
    <view class="lane-modal-card" catchtap="stopProp">
      <view class="lane-modal-header">
        <view class="lane-hero-summary">
          <image wx:if="{{pendingHero}}" src="https://game.gtimg.cn/images/yxzj/img201606/heroimg/{{pendingHero.ename}}/{{pendingHero.ename}}.jpg" class="lane-hero-avatar" mode="aspectFill" />
          <view>
            <view class="lane-hero-name-row">
              <text class="lane-hero-name">{{pendingHero.cname}}</text>
              <view class="lane-hero-roles">
                <block wx:for="{{pendingHeroRoles}}" wx:key="*this">
                  <text class="hero-role-pill">{{item}}</text>
                </block>
              </view>
            </view>
            <view class="lane-hero-title">{{pendingHero.title || '国服英雄'}}</view>
          </view>
        </view>
        <view class="btn-close-lane-modal" bindtap="closeLaneModal">
          <image class="close-x-svg" src="/assets/ic_close_lane.png" mode="aspectFit" />
        </view>
      </view>

      <view class="lane-select-title">选择实战分路</view>
      <view class="lane-buttons-group">
        <block wx:for="{{pendingLanes}}" wx:key="*this">
          <view class="lane-choice-btn" bindtap="confirmLaneAndEnter" data-lane="{{item}}">{{item}}</view>
        </block>
      </view>
    </view>
  </view>
</view>
