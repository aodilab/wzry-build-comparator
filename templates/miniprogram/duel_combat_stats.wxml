
    <!-- 4. 野区清理与控龙耗时 (PVE，仅打野分路显示) -->
    <view class="apple-card" wx:if="{{isJungle}}">
      <view class="apple-section-head">
        <view class="apple-section-title">野区清理与控龙耗时</view>
        <view class="apple-section-desc">单组野怪抢夺 (Buff 1.2万血) 与 史诗级大龙单刷 (3.5万血)</view>
      </view>

      <view class="compare-metric-row">
        <view class="metric-card-head">单组野怪清理耗时 (Buff 1.2万血)</view>
        <view class="metric-card-sub">起手核心爆发 + 惩击真伤快速收割</view>
        <view class="metric-cols-row">
          <view class="metric-side-col">
            <view class="metric-num-val">{{outA.buffTime || 0}}<text class="metric-num-unit">s</text></view>
          </view>
          <view class="metric-vs-sep">vs</view>
          <view class="metric-side-col">
            <view class="metric-num-val">{{outB.buffTime || 0}}<text class="metric-num-unit">s</text></view>
          </view>
        </view>
        <view class="metric-winner-wrap">
          <text class="apple-winner-pill {{pills.buffTime.cls}}">{{pills.buffTime.text}}</text>
        </view>
      </view>

      <view class="compare-metric-row">
        <view class="metric-card-head">单刷主宰/暴君耗时 (3.5万血)</view>
        <view class="metric-card-sub">技能真空期普攻站桩输出效率</view>
        <view class="metric-cols-row">
          <view class="metric-side-col">
            <view class="metric-num-val">{{outA.dragonTime || 0}}<text class="metric-num-unit">s</text></view>
          </view>
          <view class="metric-vs-sep">vs</view>
          <view class="metric-side-col">
            <view class="metric-num-val">{{outB.dragonTime || 0}}<text class="metric-num-unit">s</text></view>
          </view>
        </view>
        <view class="metric-winner-wrap">
          <text class="apple-winner-pill {{pills.dragonTime.cls}}">{{pills.dragonTime.text}}</text>
        </view>
      </view>
    </view>

    <!-- 5. 生存与续航对决卡片 -->
    <view class="apple-card">
      <view class="apple-section-head">
        <view class="apple-section-title">生存与续航对决</view>
        <view class="apple-section-desc">英雄技能回复公式 + 物理/法术吸血率 + 脱战常态回复</view>
      </view>

      <view class="compare-metric-row">
        <view class="metric-card-head">{{vampTitle}}</view>
        <view class="metric-card-sub">{{vampSub}}</view>
        <view class="metric-cols-row">
          <view class="metric-side-col">
            <view class="metric-num-val">{{outA.aHitVamp || 0}}<text class="metric-num-unit">点</text></view>
          </view>
          <view class="metric-vs-sep">vs</view>
          <view class="metric-side-col">
            <view class="metric-num-val">{{outB.aHitVamp || 0}}<text class="metric-num-unit">点</text></view>
          </view>
        </view>
        <view class="metric-winner-wrap">
          <text class="apple-winner-pill {{pills.vamp.cls}}">{{pills.vamp.text}}</text>
        </view>
      </view>

      <view class="compare-metric-row">
        <view class="metric-card-head">脱战每秒常态回血</view>
        <view class="metric-card-sub">基础自然回血 + 霸者重装/不死鸟被动</view>
        <view class="metric-cols-row">
          <view class="metric-side-col">
            <view class="metric-num-val">{{outA.outOfCombatRegen || 0}}<text class="metric-num-unit">点/s</text></view>
          </view>
          <view class="metric-vs-sep">vs</view>
          <view class="metric-side-col">
            <view class="metric-num-val">{{outB.outOfCombatRegen || 0}}<text class="metric-num-unit">点/s</text></view>
          </view>
        </view>
        <view class="metric-winner-wrap">
          <text class="apple-winner-pill {{pills.regen.cls}}">{{pills.regen.text}}</text>
        </view>
      </view>

      <view class="compare-metric-row">
        <view class="metric-card-head">{{outA.healDef || '核心技能回复'}}</view>
        <view class="metric-card-sub">健康血线完整单次回复</view>
        <view class="metric-cols-row">
          <view class="metric-side-col">
            <view class="metric-num-val">{{outA.regularHeal || 0}}<text class="metric-num-unit">点</text></view>
          </view>
          <view class="metric-vs-sep">vs</view>
          <view class="metric-side-col">
            <view class="metric-num-val">{{outB.regularHeal || 0}}<text class="metric-num-unit">点</text></view>
          </view>
        </view>
        <view class="metric-winner-wrap">
          <text class="apple-winner-pill {{pills.healReg.cls}}">{{pills.healReg.text}}</text>
        </view>
      </view>

      <view class="compare-metric-row">
        <view class="metric-card-head">残血极限回复 (生命≤30%)</view>
        <view class="metric-card-sub">计入不死鸟之眼血统被动最高增幅</view>
        <view class="metric-cols-row">
          <view class="metric-side-col">
            <view class="metric-num-val">{{outA.clutchHeal || 0}}<text class="metric-num-unit">点</text></view>
          </view>
          <view class="metric-vs-sep">vs</view>
          <view class="metric-side-col">
            <view class="metric-num-val">{{outB.clutchHeal || 0}}<text class="metric-num-unit">点</text></view>
          </view>
        </view>
        <view class="metric-winner-wrap">
          <text class="apple-winner-pill {{pills.clutchHeal.cls}}">{{pills.clutchHeal.text}}</text>
        </view>
      </view>
    </view>

    <!-- 6. 技能实际冷却时间卡片 -->
    <view class="apple-card">
      <view class="apple-section-head">
        <view class="apple-section-title">技能实际冷却时间</view>
        <view class="apple-section-desc">满级满装技能真空期 · 方案 A 冷却加成 {{statsA.cdr || 0}}% vs 方案 B {{statsB.cdr || 0}}%</view>
      </view>

      <block wx:for="{{cdRows}}" wx:key="title">
        <view class="compare-metric-row">
          <view class="metric-card-head">{{item.title}}</view>
          <view class="metric-card-sub">{{item.sub}}</view>
          <view class="metric-cols-row">
            <view class="metric-side-col">
              <view class="metric-num-val">{{item.cdA}}<text class="metric-num-unit">s</text></view>
            </view>
            <view class="metric-vs-sep">vs</view>
            <view class="metric-side-col">
              <view class="metric-num-val">{{item.cdB}}<text class="metric-num-unit">s</text></view>
            </view>
          </view>
          <view class="metric-winner-wrap">
            <text class="apple-winner-pill {{item.pill.cls}}">{{item.pill.text}}</text>
          </view>
        </view>
      </block>
    </view>

    <!-- 7. 核心机制差异卡片 -->
    <view class="apple-card">
      <view class="apple-section-head">
        <view class="apple-section-title">核心机制差异</view>
        <view class="apple-section-desc">双方关键机制点对点对比，剔除无差异项</view>
      </view>

      <view class="mechanic-diff-deck">
        <block wx:if="{{mechanicDiff.isEmpty}}">
          <view class="mechanic-empty-box">
            <view class="mechanic-empty-title">双方装备配置完全一致</view>
            <view class="mechanic-empty-sub">两套方案装备完全相同，胜负重点取决于铭文配置与局内等级。</view>
          </view>
        </block>
        <block wx:else>
          <!-- 1. 机制取向差异 -->
          <view class="mechanic-section-group" wx:if="{{mechanicDiff.contrasts.length > 0}}">
            <view class="mechanic-group-header">
              <text class="mechanic-group-tag tag-contrast">机制取向差异</text>
              <text class="mechanic-group-sub">同类被动选择不同</text>
            </view>
            <view class="mechanic-exclusive-list">
              <block wx:for="{{mechanicDiff.contrasts}}" wx:key="index">
                <view class="mechanic-contrast-row">
                  <view class="mechanic-contrast-side">
                    <text class="scheme-name-tag">方案 A</text>
                    <view class="m-contrast-title">
                      <text>{{item.itemA.name}}</text>
                      <text class="m-badge-pill">{{item.itemA.label}}</text>
                    </view>
                    <view class="m-item-desc">{{item.itemA.desc}}</view>
                  </view>
                  <view class="mechanic-contrast-vs">vs</view>
                  <view class="mechanic-contrast-side">
                    <text class="scheme-name-tag">方案 B</text>
                    <view class="m-contrast-title">
                      <text>{{item.itemB.name}}</text>
                      <text class="m-badge-pill pill-green">{{item.itemB.label}}</text>
                    </view>
                    <view class="m-item-desc">{{item.itemB.desc}}</view>
                  </view>
                </view>
              </block>
            </view>
          </view>

          <!-- 2. 方案 A 专属机制 -->
          <view class="mechanic-section-group" wx:if="{{mechanicDiff.exclusiveA.length > 0}}">
            <view class="mechanic-group-header">
              <text class="mechanic-group-tag tag-a">方案 A 专属机制 ({{mechanicDiff.exclusiveA.length}} 项)</text>
            </view>
            <view class="mechanic-exclusive-list">
              <block wx:for="{{mechanicDiff.exclusiveA}}" wx:key="index">
                <view class="mechanic-exclusive-item">
                  <view class="m-item-head">
                    <text class="m-equip-name">{{item.name}}</text>
                    <text class="m-badge-pill">{{item.label}}</text>
                  </view>
                  <view class="m-item-desc">{{item.desc}}</view>
                </view>
              </block>
            </view>
          </view>

          <!-- 3. 方案 B 专属机制 -->
          <view class="mechanic-section-group" wx:if="{{mechanicDiff.exclusiveB.length > 0}}">
            <view class="mechanic-group-header">
              <text class="mechanic-group-tag tag-b">方案 B 专属机制 ({{mechanicDiff.exclusiveB.length}} 项)</text>
            </view>
            <view class="mechanic-exclusive-list">
              <block wx:for="{{mechanicDiff.exclusiveB}}" wx:key="index">
                <view class="mechanic-exclusive-item">
                  <view class="m-item-head">
                    <text class="m-equip-name">{{item.name}}</text>
                    <text class="m-badge-pill pill-green">{{item.label}}</text>
                  </view>
                  <view class="m-item-desc">{{item.desc}}</view>
                </view>
              </block>
            </view>
          </view>
        </block>
      </view>
    </view>

    <!-- 8. 综合属性规格清单卡片 -->
    <view class="apple-card">
      <view class="apple-section-head">
        <view class="apple-section-title">综合属性规格</view>
        <view class="apple-section-desc">15级满级基础属性 + 铭文 + 6件神装参数</view>
      </view>

      <view class="stats-filter-bar">
        <view class="stats-filter-btn {{filterStatsDiffOnly ? 'active' : ''}}" bindtap="setStatsFilter" data-diff="{{true}}">仅看差异</view>
        <view class="stats-filter-btn {{!filterStatsDiffOnly ? 'active' : ''}}" bindtap="setStatsFilter" data-diff="{{false}}">看全部</view>
      </view>

      <view class="specs-list-box">
        <block wx:if="{{displaySpecRows.length === 0}}">
          <view class="specs-empty-tip">两套方案基础面板参数完全一致</view>
        </block>
        <block wx:else>
          <block wx:for="{{displaySpecRows}}" wx:key="name">
            <view class="spec-item-row">
              <view class="spec-left-val {{item.aWin ? 'win-blue' : ''}}">{{item.valA}}</view>
              <view class="spec-mid-name">{{item.name}}</view>
              <view class="spec-right-val {{item.bWin ? 'win-green' : ''}}">{{item.valB}}</view>
            </view>
          </block>
        </block>
      </view>
    </view>

  </view>
</view>
