// 微信小程序视图层 (WebView) 120fps 原生下拉关闭手势引擎 (零 setData 桥接延迟)
var startY = 0;
var startX = 0;
var currentY = 0;
var startTime = 0;
var activeKey = '';
var isDragging = false;
var scrollMap = {
  inspector: 0,
  shop: 0,
  arcana: 0,
  skill: 0
};

function snapBackUp(ownerInstance, key) {
  if (!ownerInstance || !key) return;
  var box = ownerInstance.selectComponent('.sheet-box-' + key);
  if (box) {
    box.setStyle({
      transform: 'translate3d(0, 0, 0)',
      opacity: '1',
      transition: 'transform 0.32s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.32s ease'
    });
  }
  var mask = ownerInstance.selectComponent('.modal-mask-' + key);
  if (mask) {
    mask.setStyle({
      opacity: '1',
      transition: 'opacity 0.32s ease'
    });
  }
}

function handleShowChange(key, newVal, oldVal, ownerInstance) {
  scrollMap[key] = 0;
  if (!ownerInstance || !key) return;
  // 仅在打开弹窗时清除上次手势残留；关闭时绝不重置为 (0,0,0)，彻底根除关闭前闪现整屏的 Bug
  if (newVal) {
    var box = ownerInstance.selectComponent('.sheet-box-' + key);
    if (box) {
      box.setStyle({});
    }
    var mask = ownerInstance.selectComponent('.modal-mask-' + key);
    if (mask) {
      mask.setStyle({});
    }
  }
}

function onInspectorShowChange(newVal, oldVal, ownerInstance) {
  handleShowChange('inspector', newVal, oldVal, ownerInstance);
}

function onShopShowChange(newVal, oldVal, ownerInstance) {
  handleShowChange('shop', newVal, oldVal, ownerInstance);
}

function onArcanaShowChange(newVal, oldVal, ownerInstance) {
  handleShowChange('arcana', newVal, oldVal, ownerInstance);
}

function onSkillShowChange(newVal, oldVal, ownerInstance) {
  handleShowChange('skill', newVal, oldVal, ownerInstance);
}

function onScroll(e) {
  var dataset = (e && e.currentTarget && e.currentTarget.dataset) || {};
  var key = dataset.sheet;
  if (key && e.detail) {
    scrollMap[key] = e.detail.scrollTop || 0;
  }
}

function onScrollToUpper(e) {
  var dataset = (e && e.currentTarget && e.currentTarget.dataset) || {};
  var key = dataset.sheet;
  if (key) {
    scrollMap[key] = 0;
  }
}

function onTouchStart(e, ownerInstance) {
  if (!e.touches || e.touches.length === 0) return;
  var target = e.target;
  if (target && target.dataset && target.dataset.role === 'close') {
    activeKey = '';
    isDragging = false;
    return;
  }
  var dataset = (e.currentTarget && e.currentTarget.dataset) || {};
  var key = dataset.sheet;
  var zone = dataset.zone || 'header';
  if (!key) return;

  if (zone === 'body' && (scrollMap[key] || 0) > 10) {
    activeKey = '';
    isDragging = false;
    return;
  }

  activeKey = key;
  isDragging = false;
  startY = e.touches[0].clientY;
  startX = e.touches[0].clientX;
  currentY = startY;
  startTime = e.timeStamp || getDate().getTime();
}

function onTouchMove(e, ownerInstance) {
  if (!activeKey || !e.touches || e.touches.length === 0) return;
  var y = e.touches[0].clientY;
  var x = e.touches[0].clientX;
  var dy = y - startY;
  var dx = x - startX;
  currentY = y;

  if (!isDragging) {
    if (dy < -6 || Math.abs(dx) > Math.abs(dy) + 4) {
      activeKey = '';
      return;
    }
    if (dy > 6 && dy > Math.abs(dx)) {
      isDragging = true;
    } else {
      return;
    }
  }

  var moveY = dy > 0 ? dy : dy * 0.18;
  var box = ownerInstance.selectComponent('.sheet-box-' + activeKey);
  var mask = ownerInstance.selectComponent('.modal-mask-' + activeKey);

  var sheetOpacity = '1';
  var maskOpacity = '1';
  if (dy > 0) {
    // 苹果半透明衰减质感：手势下拉时，卡片透明度由 1.0 丝滑渐变至 0.78，显露底层内容
    var sO = 1 - (moveY / 580) * 0.25;
    if (sO < 0.78) sO = 0.78;
    sheetOpacity = sO.toFixed(3);

    // 背景遮罩层同步淡出
    var mO = 1 - (moveY / 420);
    if (mO < 0) mO = 0;
    maskOpacity = mO.toFixed(3);
  }

  if (box) {
    box.setStyle({
      transform: 'translate3d(0, ' + moveY + 'px, 0)',
      opacity: sheetOpacity,
      transition: 'none'
    });
  }
  if (mask && dy > 0) {
    mask.setStyle({
      opacity: maskOpacity,
      transition: 'none'
    });
  }
}

function onTouchEnd(e, ownerInstance) {
  if (!activeKey) return;
  var key = activeKey;
  var dragging = isDragging;
  activeKey = '';
  isDragging = false;

  if (!dragging) return;

  var endY = (e.changedTouches && e.changedTouches.length > 0)
    ? e.changedTouches[0].clientY
    : currentY;
  var dy = endY - startY;
  var endTime = e.timeStamp || getDate().getTime();
  var dt = Math.max(1, endTime - startTime);
  var velocity = dy / dt;

  var box = ownerInstance.selectComponent('.sheet-box-' + key);
  var mask = ownerInstance.selectComponent('.modal-mask-' + key);

  // 苹果标准手势判断：下拉超过 95px，或向下滑速超过 0.40 且下拉超过 35px
  if (dy > 95 || (velocity > 0.40 && dy > 35)) {
    if (box) {
      box.setStyle({
        transform: 'translate3d(0, 100%, 0)',
        opacity: '0',
        transition: 'transform 0.28s cubic-bezier(0.32, 0.72, 0, 1), opacity 0.28s ease'
      });
    }
    if (mask) {
      mask.setStyle({
        opacity: '0',
        transition: 'opacity 0.28s ease'
      });
    }
    scrollMap[key] = 0;
    ownerInstance.callMethod('closeSheetFromWxs', { key: key });
  } else {
    snapBackUp(ownerInstance, key);
  }
}

module.exports = {
  onInspectorShowChange: onInspectorShowChange,
  onShopShowChange: onShopShowChange,
  onArcanaShowChange: onArcanaShowChange,
  onSkillShowChange: onSkillShowChange,
  onScroll: onScroll,
  onScrollToUpper: onScrollToUpper,
  onTouchStart: onTouchStart,
  onTouchMove: onTouchMove,
  onTouchEnd: onTouchEnd
};
