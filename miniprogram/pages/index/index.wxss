/* 王者出装推演 ｜ 页面一：挑选英雄大厅 (1:1 复刻 preview_miniprogram.html) */
page {
  background-color: #ffffff;
  color: #1d1d1f;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

.hall-page {
  background: #ffffff;
  min-height: 100vh;
}

.hall-wrap {
  padding: 24px 20px 40px;
  display: flex;
  flex-direction: column;
}

.hall-main-title {
  font-size: 26px;
  font-weight: 700;
  color: #000000;
  letter-spacing: -0.02em;
}

.hall-sub-title {
  font-size: 13px;
  color: #8e8e93;
  margin-top: 4px;
  margin-bottom: 18px;
}

.apple-search-box {
  position: relative;
  display: flex;
  align-items: center;
  margin-bottom: 16px;
}

.search-svg-icon {
  position: absolute;
  left: 14px;
  width: 16px;
  height: 16px;
  pointer-events: none;
  z-index: 2;
}

.apple-search-input {
  width: 100%;
  height: 42px;
  background: #ffffff;
  border-radius: 12px;
  padding: 0 14px 0 40px;
  font-size: 14px;
  border: 1.5px solid #e1e6ed;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  outline: none;
  color: #000000;
  box-sizing: border-box;
  transition: all 0.18s ease;
}

.search-ph {
  color: #8e8e93;
  font-size: 14px;
}

.apple-seg-control {
  display: flex;
  background: transparent;
  padding: 2px 0;
  margin-bottom: 18px;
  gap: 5px;
  width: 100%;
}

.apple-seg-item {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 6px 0;
  font-size: 12px;
  color: #1d1d1f;
  background: #ffffff;
  border: 1px solid #e5e5ea;
  border-radius: 999px;
  font-weight: 500;
  white-space: nowrap;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
  transition: all 0.18s ease;
}

.apple-seg-item.active {
  background: #007aff;
  border-color: #007aff;
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 3px 10px rgba(0, 122, 255, 0.28);
}

.hall-hero-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px 12px;
  padding: 4px 0 30px;
  justify-items: center;
}

.hall-hero-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  min-width: 0;
  width: 100%;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.hall-hero-tile:active {
  transform: scale(0.92);
  opacity: 0.8;
}

.hall-hero-avatar {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  border: 2px solid #ffffff;
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
  background: #f2f2f7;
}

.hall-hero-name {
  font-size: 13px;
  font-weight: 600;
  color: #1d1d1f;
  margin-top: 6px;
  line-height: 1.2;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 英雄分路选择弹窗 (#laneSelectModal) */
.lane-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: none;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.lane-modal-mask.active {
  display: flex;
}

.lane-modal-card {
  width: 320px;
  background: #ffffff;
  border-radius: 24px;
  padding: 20px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
}

.lane-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.lane-hero-summary {
  display: flex;
  align-items: center;
  gap: 12px;
}

.lane-hero-avatar {
  width: 44px;
  height: 44px;
  border-radius: 50%;
}

.lane-hero-name-row {
  display: flex;
  align-items: center;
  gap: 6px;
}

.lane-hero-name {
  font-size: 16px;
  font-weight: 700;
  color: #1d1d1f;
}

.lane-hero-roles {
  display: flex;
  gap: 3px;
}

.hero-role-pill {
  font-size: 10.5px;
  font-weight: 500;
  color: #636366;
  background: #f2f2f7;
  padding: 1.5px 6.5px;
  border-radius: 4px;
  white-space: nowrap;
  border: 0.5px solid rgba(0, 0, 0, 0.04);
  line-height: 1.25;
}

.lane-hero-title {
  font-size: 12px;
  color: #86868b;
  margin-top: 2px;
}

.btn-close-lane-modal {
  padding: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-x-svg {
  width: 10px;
  height: 10px;
  display: block;
}

.lane-select-title {
  font-size: 14px;
  font-weight: 600;
  color: #86868b;
  margin-bottom: 12px;
}

.lane-buttons-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.lane-choice-btn {
  height: 44px;
  border-radius: 12px;
  border: 1px solid #ebebf0;
  background: #ffffff;
  color: #1d1d1f;
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
  transition: all 0.15s ease;
}

.lane-choice-btn:active {
  border-color: #007aff;
  color: #007aff;
  background: rgba(0, 122, 255, 0.05);
}
